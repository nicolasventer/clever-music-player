		"@scaleway/random-name": "5.1.2",
		"clsx": "2.1.1",
		"js-base64": "3.7.8",
		"lucide-react": "0.541.0",
		"music-metadata": "11.8.3",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"react-hot-toast": "2.6.0"
	},
	"resolutions": {
		"sharp": "0.32.6",
		"sharp-ico": "0.1.5"
